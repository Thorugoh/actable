{
  "name": "rn-arch-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/todo/*"
  ],
  "scripts": {
    "todo": "tsx examples/todo/cli/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @actable/react-native && npm run typecheck -w @todo/mobile",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "ios": "npm run ios -w @todo/mobile",
    "e2e:ios": "maestro test examples/todo/mobile/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
